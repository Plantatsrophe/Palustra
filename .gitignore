# ==========================================
# 1. Environment Variables & API Secrets (CRITICAL)
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key

# ==========================================
# 2. Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# Type Checking & Linters
.mypy_cache/
.pytype/
.ruff_cache/

# ==========================================
# 3. SQLite & Database Runtime Artifacts
# ==========================================
# Ignore local SQLite database files created at runtime
*.db
*.sqlite
*.sqlite3

# SQLite Write-Ahead Logging & temporary files (from Prompt R3)
*-wal
*-shm
*.db-journal

# Keep the raw seed files in backend/data/, but ignore generated DBs
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3

# ==========================================
# 4. Node.js / Next.js Frontend
# ==========================================
# Dependencies (Must NEVER be committed)
frontend/node_modules/
node_modules/
.pnp
.pnp.js

# Next.js Build Output & Cache
frontend/.next/
frontend/out/
.next/
out/

# Production Build Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel / Turbopack
.vercel/
.turbo/

# TypeScript Cache
*.tsbuildinfo

# ==========================================
# 5. Generated Report Outputs & Temp Files
# ==========================================
# Prevent test-generated PDFs and GeoJSON from cluttering git
output/
temp/
tmp/
*.pdf
!backend/app/templates/**/*.pdf
*.geojson
!backend/tests/fixtures/**/*.geojson

# ==========================================
# 6. Operating System & Editor Junk
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~